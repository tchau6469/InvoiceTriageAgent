# Application
INVOICE_TRIAGE_ENVIRONMENT=dev

# Local PostgreSQL container
POSTGRES_DB=invoice_triage
POSTGRES_USER=invoice_triage
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# Host-side Python processes connect through the published localhost port.
# Keep the username, password, database, and port synchronized with the fields above.
# URL-encode the username or password if it contains URL-reserved characters.
INVOICE_TRIAGE_DATABASE_URL=postgresql://invoice_triage:replace-with-a-local-development-password@localhost:5432/invoice_triage

# Step 3: embedding configuration
INVOICE_TRIAGE_EMBEDDING_MODEL_ID=not-configured
INVOICE_TRIAGE_EMBEDDING_DIMENSIONS=1024

# Retrieval defaults
INVOICE_TRIAGE_RETRIEVAL_TOP_K=5
INVOICE_TRIAGE_VECTOR_CANDIDATES=20
INVOICE_TRIAGE_KEYWORD_CANDIDATES=20
