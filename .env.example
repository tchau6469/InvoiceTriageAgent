# Application
INVOICE_TRIAGE_ENVIRONMENT=dev

# Local PostgreSQL container
POSTGRES_DB=invoice_triage
POSTGRES_USER=invoice_triage
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# Host-side Python processes connect through the published localhost port.
# Keep the username, password, database, and port synchronized with the fields above.
# URL-encode the username or password if it contains URL-reserved characters.
INVOICE_TRIAGE_DATABASE_URL=postgresql://invoice_triage:replace-with-a-local-development-password@localhost:5432/invoice_triage

# Local document embedding. Model weights are public; no API key is required.
INVOICE_TRIAGE_EMBEDDING_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
INVOICE_TRIAGE_EMBEDDING_DIMENSIONS=1024
INVOICE_TRIAGE_EMBEDDING_DEVICE=cpu
INVOICE_TRIAGE_EMBEDDING_BATCH_SIZE=8

# Retrieval defaults
INVOICE_TRIAGE_RETRIEVAL_TOP_K=5
INVOICE_TRIAGE_VECTOR_CANDIDATES=20
INVOICE_TRIAGE_KEYWORD_CANDIDATES=20
INVOICE_TRIAGE_RRF_K=60
INVOICE_TRIAGE_RERANK_CANDIDATES=10
INVOICE_TRIAGE_RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L6-v2
INVOICE_TRIAGE_RERANKER_DEVICE=cpu
INVOICE_TRIAGE_RERANKER_BATCH_SIZE=4
INVOICE_TRIAGE_RERANKER_MAX_LENGTH=512

# Hosted structured reasoning. Use synthetic fixtures only on the free tier.
INVOICE_TRIAGE_REASONING_PROVIDER=gemini
INVOICE_TRIAGE_REASONING_MODEL_ID=gemini-3.5-flash
INVOICE_TRIAGE_INVOICE_SOURCE_ROOT=fixtures/invoices
GEMINI_API_KEY=replace-with-a-google-ai-studio-api-key
